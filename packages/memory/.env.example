# Optional. Defaults to packages/memory/src/memory.db, resolved from the repo root.
# DB_FILE_NAME=./packages/memory/src/memory.db

# Memory backend. Leave both blank to run Supermemory locally — the server is
# installed and started on first use and nothing leaves your machine.
#
# Set an API key to use Supermemory cloud instead (memories are sent off-device).
# SUPERMEMORY_API_KEY=

# Set only if you run the server yourself; skips the automatic local startup.
# The SDK's local default is http://localhost:8787.
# SUPERMEMORY_BASE_URL=http://localhost:8787
